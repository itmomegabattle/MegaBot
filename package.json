    "verify:sheets": "tsx scripts/verify-google-sheets-primary.ts",
    "verify:database-sheets": "tsx scripts/verify-google-sheets-database.ts",
    "deploy:selectel": "bash scripts/deploy-selectel.sh",
    "sheets:mapping": "tsx scripts/google-sheets-admin.ts mapping",
    "sheets:list": "tsx scripts/google-sheets-admin.ts sheets",
    "sheets:template": "tsx scripts/google-sheets-admin.ts template",
    "sheets:backup": "tsx scripts/google-sheets-admin.ts backup",
    "sheets:prepare": "tsx scripts/google-sheets-admin.ts prepare",
    "sheets:migrate": "tsx scripts/google-sheets-admin.ts migrate",
    "sheets:weeks": "tsx scripts/google-sheets-admin.ts weeks",
    "sheets:import-preview": "tsx scripts/google-sheets-admin.ts import-preview",
    "sheets:layout": "tsx scripts/google-sheets-admin.ts layout",
    "sheets:range": "tsx scripts/google-sheets-admin.ts range",
    "sheets:roundtrip-test": "tsx scripts/google-sheets-admin.ts roundtrip-test",
    "sheets:export-all": "tsx scripts/google-sheets-admin.ts export-all",
    "db:sheets:check": "tsx scripts/google-sheets-database-admin.ts check",
    "db:sheets:status": "tsx scripts/google-sheets-database-admin.ts status",
    "db:sheets:backup": "tsx scripts/google-sheets-database-admin.ts backup",
    "db:sheets:restore": "tsx scripts/google-sheets-database-admin.ts restore-backup",
    "db:sheets:reset": "tsx scripts/google-sheets-database-admin.ts reset-operational-data",
