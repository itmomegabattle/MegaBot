POSTGRES_ADMIN_USER=megabot_admin
POSTGRES_ADMIN_PASSWORD=replace-with-local-admin-password
MEGABOT_DB_NAME=megabot
MEGABOT_DB_USERNAME=megabot_app
MEGABOT_DB_PASSWORD=replace-with-local-app-password
MEGABOT_DB_URL=jdbc:postgresql://db:5432/megabot
MEGABOT_JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=70 -XX:InitialRAMPercentage=20
TELEGRAM_BOT_TOKEN=
# Keep delivery disabled until an explicitly approved test/live rollout. A token alone cannot enable sends.
MEGABOT_DELIVERY_ENABLED=false
# Meeting reminder offset in minutes; 0 disables new reminder scheduling, max 1440.
MEETING_REMINDER_MINUTES=60
# Owner-approved noon Moscow schedule; payment settings unchanged, sender disabled.
BIRTHDAY_REMINDER_HOUR=12
BIRTHDAY_PAYMENT_PHONE=89105408050
BIRTHDAY_PAYMENT_BANK=Сбер
BIRTHDAY_GIFT_MAX_AMOUNT=400
BROADCAST_RATE_LIMIT_WINDOW_MS=600000
BROADCAST_RATE_LIMIT_MAX=10
BROADCAST_VOLUME_WINDOW_MS=3600000
BROADCAST_VOLUME_MAX_RECIPIENTS=500
MEGABOT_TELEGRAM_MODE=disabled
# Separate incoming transport; do not register a live webhook until commands/worker are ready.
MEGABOT_TELEGRAM_INCOMING_MODE=disabled
MEGABOT_TELEGRAM_BOT_ID=
# Independent random secret, 32-256 Telegram-safe characters, never the bot token.
MEGABOT_TELEGRAM_WEBHOOK_SECRET=
ADMIN_TELEGRAM_IDS=
MEGABOT_ALLOWED_ORIGINS=http://localhost:5173
